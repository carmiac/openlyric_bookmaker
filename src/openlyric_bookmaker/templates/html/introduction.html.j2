<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Introduction">
    <meta name="theme-color" content="#009688">
    <link rel="manifest" href="manifest.json">
    <title>Introduction</title>
    <style>
        /* CSS Variables for theming */
        :root {
            --bg-primary: #ffffff;
            --text-primary: #000000;
            --text-secondary: #666666;
            --border-color: #333333;
        }
        
        [data-theme="dark"] {
            --bg-primary: #1e1e1e;
            --text-primary: #e0e0e0;
            --text-secondary: #b0b0b0;
            --border-color: #555555;
        }
        
        body {
            font-family: Georgia, 'Times New Roman', serif;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            line-height: 1.6;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.3s, color 0.3s;
        }
        
        /* Font size variants */
        body[data-font-size="small"] { font-size: 14px; }
        body[data-font-size="medium"] { font-size: 16px; }
        body[data-font-size="large"] { font-size: 18px; }
        
        h1 {
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 0.5em;
            color: var(--text-primary);
        }
        .metadata {
            color: var(--text-secondary);
            font-style: italic;
            margin-bottom: 2em;
        }
        .blurb {
            white-space: pre-wrap;
            margin-bottom: 1.5em;
        }
        
        /* Print styles */
        @media print {
            /* Force light theme for printing */
            :root {
                --bg-primary: #ffffff;
                --text-primary: #000000;
                --text-secondary: #666666;
                --border-color: #333333;
            }
            
            body {
                background: white;
                color: black;
                font-size: 12pt;
                margin: 0.5in;
            }
            
            h1 {
                page-break-after: avoid;
                break-after: avoid;
            }
            
            .metadata {
                page-break-after: avoid;
                break-after: avoid;
            }
        }
    </style>
</head>
<body>
    <h1>{{ config.title }}</h1>
    
    <div class="metadata">
        {% if config.author %}
        <div>Compiled by: {{ config.author }}</div>
        {% endif %}
        {% if config.publish_date %}
        <div>Published: {{ config.publish_date }}</div>
        {% endif %}
        {% if config.license %}
        <div>License: {{ config.license }}</div>
        {% endif %}
    </div>

    {% if config.title_blurb %}
    <div class="blurb">{{ config.title_blurb }}</div>
    {% endif %}

    {% if intro %}
    <div class="introduction">
        {{ intro }}
    </div>
    {% endif %}
</body>
</html>

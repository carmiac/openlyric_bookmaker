<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ song.title }}</title>
    <style>
        /* CSS Variables for theming */
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f5f5f5;
            --text-primary: #000000;
            --text-secondary: #666666;
            --border-color: #333333;
            --chord-color: #0066cc;
            --comment-bg: #f5f5f5;
            --comment-border: #999999;
        }
        
        [data-theme="dark"] {
            --bg-primary: #1e1e1e;
            --bg-secondary: #2d2d2d;
            --text-primary: #e0e0e0;
            --text-secondary: #b0b0b0;
            --border-color: #555555;
            --chord-color: #6ba3ff;
            --comment-bg: #2d2d2d;
            --comment-border: #555555;
        }
        
        /* Override any OpenLyrics CSS that might cause issues */
        song::before { display: none !important; }
        song { all: unset; }
        
        body {
            font-family: Georgia, 'Times New Roman', serif;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
            line-height: 1.6;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.3s, color 0.3s;
        }
        
        /* Font size variants */
        body[data-font-size="small"] {
            font-size: 14px;
        }
        body[data-font-size="medium"] {
            font-size: 16px;
        }
        body[data-font-size="large"] {
            font-size: 18px;
        }
        
        @media (max-width: 768px) {
            body {
                padding: 10px;
            }
            body[data-font-size="small"] { font-size: 12px; }
            body[data-font-size="medium"] { font-size: 14px; }
            body[data-font-size="large"] { font-size: 16px; }
        }
        .song {
            margin-bottom: 2em;
        }
        .song-header {
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 1.5em;
            padding-bottom: 0.5em;
        }
        .song-title {
            font-size: 2em;
            font-weight: bold;
            margin: 0;
            color: var(--text-primary);
        }
        .song-metadata {
            color: var(--text-secondary);
            font-style: italic;
            margin-top: 0.5em;
        }
        .song-comment {
            background: var(--comment-bg);
            border-left: 3px solid var(--comment-border);
            padding: 0.5em 1em;
            margin: 1em 0;
            font-style: italic;
            color: var(--text-primary);
        }
        .verse {
            margin-bottom: 1.5em;
        }
        .verse-label {
            font-weight: bold;
            color: var(--text-secondary);
            margin-bottom: 0.5em;
        }
        .chorus {
            margin-left: 2em;
            font-style: italic;
        }
        .verse-line {
            position: relative;
            margin-bottom: 0.2em;
            padding-top: 1.2em;  /* Space for chords above */
            line-height: 1.4;
        }
        .chords {
            position: absolute;
            top: 0;  /* Position at top of padding */
            left: 0;
            color: var(--chord-color);
            font-weight: bold;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            white-space: pre;
            pointer-events: none;
            line-height: 1;
        }
        .line-text {
            white-space: pre-wrap;
            line-height: 1.4;
        }
        /* Only use monospace for lines with chords */
        .verse-line.has-chords .line-text {
            font-family: 'Courier New', monospace;
        }
        .line-comment {
            font-size: 0.9em;
            color: #666;
            font-style: italic;
            margin-left: 1em;
        }
        .recordings {
            margin-top: 2em;
            padding-top: 1em;
            border-top: 1px solid var(--border-color);
        }
        .recordings h3 {
            margin-top: 0;
            color: var(--text-primary);
        }
        .recording {
            margin-bottom: 2em;
        }
        .recording-title {
            font-weight: bold;
            color: var(--text-primary);
        }
        .recording-artist {
            font-style: italic;
            color: var(--text-secondary);
            margin-bottom: 0.5em;
        }
        .recording-player {
            margin-top: 0.5em;
        }
        .youtube-embed {
            position: relative;
            padding-bottom: 56.25%; /* 16:9 aspect ratio */
            height: 0;
            overflow: hidden;
            max-width: 100%;
            background: #000;
        }
        .youtube-embed iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
        .audio-player {
            width: 100%;
            max-width: 500px;
        }
        .recording-link {
            margin-top: 0.5em;
            font-size: 0.9em;
        }
        .recording-link a {
            color: var(--chord-color);
            text-decoration: none;
        }
        .recording-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="song">
        <div class="song-header">
            <h1 class="song-title">{{ song.title }}</h1>
            <div class="song-metadata">
                {% if song.authors %}
                <div class="authors">By: {{ song.properties.author_string }}</div>
                {% endif %}
                {% if song.properties.tune %}
                <div class="tune">Tune: {{ song.properties.tune }}</div>
                {% endif %}
                {% if song.properties.copyright %}
                <div class="copyright">© {{ song.properties.copyright }}</div>
                {% endif %}
            </div>
        </div>

        {% for comment in song.comments %}
        <div class="song-comment">{{ comment }}</div>
        {% endfor %}

        <div class="lyrics">
            {% for verse in song.ordered_verses %}
            <div class="verse {% if verse.is_chorus %}chorus{% endif %}">
                <div class="verse-label">{{ verse.display_name }}</div>
                {% for line in verse.lines %}
                <div class="verse-line {% if line.chords %}has-chords{% endif %}">
                    {% if line.chords %}
                    <div class="chords">{% for chord in line.chords %}<span style="position: absolute; left: {{ chord.position }}ch;">{{ chord.full_chord }}</span>{% endfor %}</div>
                    {% endif %}
                    <div class="line-text">{{ line.text }}</div>
                    {% if line.comment %}
                    <span class="line-comment">({{ line.comment }})</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        </div>

        {% if song.recordings %}
        <div class="recordings">
            <h3>Recordings</h3>
            {% for recording in song.recordings %}
            <div class="recording">
                {% if recording.title %}
                <div class="recording-title">{{ recording.title }}</div>
                {% endif %}
                {% if recording.artist %}
                <div class="recording-artist">{{ recording.artist }}</div>
                {% endif %}
                
                <div class="recording-player">
                    {% if recording.is_youtube %}
                        {# Extract YouTube video ID and embed #}
                        {% set video_id = recording.url.split('v=')[-1].split('&')[0] if 'v=' in recording.url else recording.url.split('/')[-1].split('?')[0] %}
                        <div class="youtube-embed">
                            <iframe src="https://www.youtube.com/embed/{{ video_id }}" 
                                    allowfullscreen
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                            </iframe>
                        </div>
                    {% elif recording.is_midi %}
                        {# MIDI player using embedded object #}
                        <div class="midi-player">
                            <p style="font-size: 0.9em; margin-bottom: 0.5em;">🎹 MIDI File</p>
                            <embed src="{{ recording.url }}" 
                                   type="audio/midi" 
                                   width="100%" 
                                   height="60"
                                   style="max-width: 500px;">
                            <p style="font-size: 0.85em; margin-top: 0.5em; color: var(--text-secondary);">
                                If the player doesn't work, <a href="{{ recording.url }}" download>download the MIDI file</a> to play it locally.
                            </p>
                        </div>
                    {% elif recording.is_audio %}
                        {# HTML5 audio player for audio files #}
                        <audio class="audio-player" controls>
                            <source src="{{ recording.url }}" type="audio/mpeg">
                            Your browser does not support the audio element.
                        </audio>
                    {% elif recording.is_video %}
                        {# HTML5 video player for video files #}
                        <video class="audio-player" controls>
                            <source src="{{ recording.url }}" type="video/mp4">
                            Your browser does not support the video element.
                        </video>
                    {% else %}
                        {# Fallback: just show a link #}
                        <div class="recording-link">
                            <a href="{{ recording.url }}" target="_blank">🔗 Open recording</a>
                        </div>
                    {% endif %}
                </div>
                
                <div class="recording-link">
                    <a href="{{ recording.url }}" target="_blank">{{ recording.url }}</a>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</body>
</html>

  <lyrics>
    <verse name="v1">
      <lines><chord root="G"/>Amazing <chord root="C"/>grace, how <chord root="G"/>sweet the sound<br/>
That <chord root="D"/>saved a <chord root="G"/>wretch like me<br/>
</lines>
    </verse>
    <verse name="v2">
      <lines><chord root="G"/>'Twas grace that <chord root="C"/>taught my <chord root="G"/>heart to fear<br/>
And <chord root="D"/>grace my <chord root="G"/>fears relieved<br/>
</lines>
    </verse>
    <verse name="c" type="chorus">
      <lines>I once was lost, but now am found<br/>
Was blind, but now I see<br/>
</lines>
    </verse>
